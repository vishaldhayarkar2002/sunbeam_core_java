class Printable{
	public void show() {
		System.out.println("Printable.show()");
	}
}
interface Displayable{
	default void show() {
		System.out.println("Displayable.show()");
	}
}


class Test extends Printable implements Displayable{
	@Override
	public void show() {
		System.out.println("Test.show()");
	}
	
}
//method overrriding -- method is called depending on type of object.
public class Program {
	public static void main(String[] args) {
		//Test t = new Test(); 
		//t.show();
		Displayable d = new Test(); 
		d.show();
	}
}





