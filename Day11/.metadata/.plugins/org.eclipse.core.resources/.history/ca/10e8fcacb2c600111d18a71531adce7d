interface Printable{
	default void show() {
		System.out.println("Printable.show()");
	}
}
interface Displayable{
	default void show() {
		System.out.println("Displayable.show()");
	}
}
//if two interfaces have default method with same signature and a class is inherited 
//from that interface,
//then it will lead to ambiguity.
class Test implements Printable , Displayable{

	@Override
	public void show() {
		System.out.println("Test.show()");
	}

	
	
}
public class Program {
	public static void main(String[] args) {
		Test t = new Test(); 
		t.show();
	}
}





