package com.sunbeam;

class Shapes{
	public static double calcTotalArea(Shape[] arr) {
		double sum = 0.0; 
		for(int i = 0 ; i < arr.length ; i++) {
			sum = sum + arr[i].calcArea(); 
		}
		return sum; 
	}
}
public class Program {

	public static void main(String[] args) {
		Shape[] arr = {
			new Rectangle(10, 2),
			new Circle(3.1),
			new Square(4.1) 
		}; 
		double totalArea = Shapes.calcTotalArea(arr); 
		System.out.println("Area : " + totalArea);
	}

}
