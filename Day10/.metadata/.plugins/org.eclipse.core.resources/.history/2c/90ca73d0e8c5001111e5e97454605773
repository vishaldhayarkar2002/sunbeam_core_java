package com.sunbeam;

import java.util.ArrayDeque;
import java.util.Queue;

public class Program {

	public static void main(String[] args) {
		Queue<String> q = new ArrayDeque<>(); 
		q.offer("One"); 
		q.offer("Two");
		q.offer("Three");
		q.offer("Four");
		
		System.out.println("Top most ele : " + q.peek());
		

	}

}
