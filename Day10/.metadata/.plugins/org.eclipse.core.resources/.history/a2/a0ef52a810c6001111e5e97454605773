package com.sunbeam;

public interface Shape {
	/*public static final*/double PI = 3.14; 
	/*public abstract*/double calcArea( );
	public static double calcTotalArea(Shape[] arr) {
		double sum = 0.0; 
		for(int i = 0 ; i < arr.length ; i++) {
			sum = sum + arr[i].calcArea(); 
		}
		return sum; 
	}
	double calcPeri( ); 
}
