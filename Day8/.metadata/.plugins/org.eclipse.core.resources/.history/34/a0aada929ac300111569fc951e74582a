package com.sunbeam;

import java.util.Arrays;

public class Program {

	public static void main(String[] args) {
		int[] arr = { 22 , 11 , 3 , 4 , 55 }; 
		for(int i = 0 ; i < arr.length ; i++) {
			System.out.println(arr[i]);
		}
		Arrays.sort(arr);
		System.out.println("Sorted Array : ");
		for(int i = 0 ; i < arr.length ; i++) {
			System.out.println(arr[i]);
		}

	}

}
