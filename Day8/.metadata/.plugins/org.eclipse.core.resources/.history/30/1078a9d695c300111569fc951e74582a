package com.sunbeam;
class Fraction{
	private int n; 
	private int d; 
	public Fraction() {
		// TODO Auto-generated constructor stub
	}
	public Fraction(int n, int d) {
		this.n = n;
		this.d = d;
	}
	public double value( ) {
		return n/d; 
	}
	@Override
	public boolean equals(Object obj) {
		Fraction other = (Fraction) obj;
		return this.value() == other.value(); 
	}
	
}
