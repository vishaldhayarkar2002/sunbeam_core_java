package com.sunbeam;

import java.io.File;
import java.util.Date;
import java.util.Scanner;

public class Program {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in); 
		System.out.print("Enter the srcPath : ");
		String srcPath = sc.next(); 
		
		File file = new File(srcPath); 
		if(!file.exists()) {
			System.out.println("Invalid Path");
			System.exit(0);
		}
		if(file.isDirectory()) {
			String[] lst = file.list(); 
			for(String l : lst) {
				System.out.println(l.toString());
			}
		}
		else if(file.isFile()) {
			System.out.println("FileName : " + file.getName());
			System.out.println("Parent :" + file.getParent());
			System.out.println("File Permission");
			if(file.canRead())
				System.out.print("Readable,");
			if(file.canWrite())
				System.out.print("Writable,");
			if(file.canExecute())
				System.out.println("Executable");
			long lstMod = file.lastModified(); 
			System.out.println("Last Modified : " + new Date(lstMod));
		}
		else
			System.out.println("Niether Directory nor file");
	}
}
